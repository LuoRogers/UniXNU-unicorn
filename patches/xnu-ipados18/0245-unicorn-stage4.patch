diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index 77b178c..95f2ebd 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -575,6 +575,10 @@ arm_init(
 	gDramSize = *dram_size;
 	pmap_first_pnum = (ppnum_t)atop(gDramBase);
 
+	/* Unicorn breadcrumb: arm_init reached, about to set up the kernel VM */
+	extern void k60_fb_stage_c(unsigned int stage, unsigned int argb);
+	k60_fb_stage_c(4, 0xFF00FF00);
+
 	arm_vm_init(xmaxmem, args);
 
 #if defined(PONG) && defined(XNU_PONG_RAMOOPS_CONSOLE) && XNU_PONG_RAMOOPS_CONSOLE
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 9766beb..6de9f83 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -664,6 +664,13 @@ LEXT(start_first_cpu)
 	 */
 	ldr	x27, [x0, #0x28]				// Video.v_baseAddr
 	ldr	x28, [x0, #0x38]				// Video.v_rowBytes
+	/* 保存到全局，供 C 侧 k60_fb_stage_c() 打卡使用 */
+	adrp	x16, EXT(k60_fb_base)@page
+	add	x16, x16, EXT(k60_fb_base)@pageoff
+	str	x27, [x16]
+	adrp	x16, EXT(k60_fb_stride)@page
+	add	x16, x16, EXT(k60_fb_stride)@pageoff
+	str	x28, [x16]
 	K60_FB_STAGE 0, 0xFF0000FF
 
 	// Unlock the core for debugging
@@ -1103,3 +1110,43 @@ arm_init_tramp:
 LEXT(native_pac_keys)
 	.space	(NATIVE_PAC_KEY_WORDS + 1) * 8, 0
 #endif /* HAS_NATIVE_PAC */
+
+/* ---- Unicorn: C-callable breadcrumb (stage 4+) ---- */
+	.text
+	.align 2
+	.globl EXT(k60_fb_stage_c)
+EXT(k60_fb_stage_c):
+	/* w0 = stage index, w1 = ARGB colour */
+	adrp	x9, EXT(k60_fb_base)@page
+	add	x9, x9, EXT(k60_fb_base)@pageoff
+	ldr	x10, [x9]
+	cbz	x10, 2f
+	adrp	x9, EXT(k60_fb_stride)@page
+	add	x9, x9, EXT(k60_fb_stride)@pageoff
+	ldr	x11, [x9]
+	mov	w12, #K60_FB_Y0
+	mov	w13, #K60_FB_STEP
+	madd	w12, w0, w13, w12
+	mul	x12, x11, x12
+	add	x12, x12, x10
+	add	x12, x12, #(K60_FB_X * 4)
+	mov	x13, #K60_FB_SIZE
+1:	mov	w14, #(K60_FB_SIZE / 2)
+3:	stp	w1, w1, [x12], #8
+	subs	w14, w14, #1
+	b.ne	3b
+	sub	x12, x12, #(K60_FB_SIZE * 4)
+	add	x12, x12, x11
+	subs	x13, x13, #1
+	b.ne	1b
+	dsb	sy
+2:	ret
+
+	.data
+	.align 3
+	.globl EXT(k60_fb_base)
+EXT(k60_fb_base):
+	.quad 0
+	.globl EXT(k60_fb_stride)
+EXT(k60_fb_stride):
+	.quad 0
